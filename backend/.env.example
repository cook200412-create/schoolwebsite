# Copy to .env (never commit .env)
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (dedicated DB user with least privilege)
MONGODB_URI=mongodb://127.0.0.1:27017/ssv_school

# Exact frontend origin(s) allowed by CORS, comma-separated (Vercel URL in production)
CLIENT_ORIGINS=http://localhost:3000
# Public URL of the frontend (used in emails)
CLIENT_URL=http://localhost:3000

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Number of proxies in front of the API (Vercel rewrite + Render = 2; local = 1)
TRUST_PROXY=1
# lax works when the frontend proxies /api (default)
COOKIE_SAMESITE=lax
UPLOAD_DIR=uploads

# Optional integrations (leave empty until configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sri Satya Sai Vidyanikethan <no-reply@example.com>"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
